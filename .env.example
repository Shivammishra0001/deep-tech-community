# Deep Tech Community — environment variable template
#
# Copy to .env.local (git-ignored) and fill in real values.
# NEVER commit a populated copy of this file, and never paste real values here.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/deeptech_db"

# ---------------------------------------------------------------------------
# JWT authentication
# ---------------------------------------------------------------------------
# Required. Minimum 32 characters. The app refuses to sign tokens without these
# and fails token verification closed, so protected routes return 403.
#
# Generate a fresh value for each, and use different values for the two:
#   openssl rand -base64 48
#
# The previous hardcoded defaults were committed to git history and are now
# rejected at runtime — they cannot be reused.
JWT_SECRET=""
REFRESH_TOKEN_SECRET=""

# ---------------------------------------------------------------------------
# Google service account (Sheets & Drive integration)
# ---------------------------------------------------------------------------
# Create the key in Google Cloud Console → IAM & Admin → Service Accounts →
# <account> → Keys → Add key → Create new key (JSON).
#
# GOOGLE_PRIVATE_KEY is the "private_key" field of that JSON, kept on one line
# with literal \n escapes (the app converts them back to newlines).
# Alternatively, place the unmodified JSON at ./service-account.json — it is
# git-ignored and picked up automatically when these variables are unset.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
GOOGLE_SHEETS_SPREADSHEET_ID=""
GOOGLE_DRIVE_FOLDER_ID=""
