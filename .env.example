# Deep Tech Society Environment Variables Configuration

# Database Connection
DATABASE_URL="postgresql://user:password@localhost:5432/deeptech_db"

# JWT Authentication Secrets
JWT_SECRET="dts-deep-tech-society-jwt-secret-key-2026-super-secure"
REFRESH_TOKEN_SECRET="dts-deep-tech-society-refresh-token-secret-2026"

# Google Service Account Credentials (For Google Sheets & Drive API Integration)
GOOGLE_SERVICE_ACCOUNT_EMAIL="service-account-name@project-id.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"
GOOGLE_SHEETS_SPREADSHEET_ID="your_google_sheets_spreadsheet_id_here"
GOOGLE_DRIVE_FOLDER_ID="your_google_drive_folder_id_here"
